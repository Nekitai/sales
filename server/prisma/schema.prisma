// Semua nominal uang disimpan sebagai INTEGER rupiah (tanpa floating point).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  KASIR
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  sales     Sale[]
  expenses  Expense[]
  returns   Return[]
  auditLogs AuditLog[]

  @@map("users")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("")
  cost      Int // harga modal per unit (rupiah)
  price     Int // harga jual per unit (rupiah)
  stock     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  saleItems SaleItem[]

  @@index([isActive, name])
  @@map("products")
}

model Sale {
  id            Int           @id @default(autoincrement())
  invoiceNo     String        @unique @map("invoice_no")
  cashierId     Int           @map("cashier_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  subtotal      Int
  discount      Int           @default(0)
  total         Int
  paymentMethod PaymentMethod @map("payment_method")
  amountPaid    Int           @map("amount_paid")
  status        SaleStatus    @default(COMPLETED)

  cashier User       @relation(fields: [cashierId], references: [id])
  items   SaleItem[]
  returns Return[]

  @@index([createdAt])
  @@index([cashierId, createdAt])
  @@map("sales")
}

model SaleItem {
  id           Int    @id @default(autoincrement())
  saleId       Int    @map("sale_id")
  productId    Int    @map("product_id")
  productName  String @map("product_name") // snapshot nama
  qty          Int
  unitPrice    Int    @map("unit_price") // snapshot harga jual
  unitCost     Int    @map("unit_cost") // snapshot HPP
  lineDiscount Int    @default(0) @map("line_discount") // alokasi diskon transaksi
  lineTotal    Int    @map("line_total") // unitPrice*qty - lineDiscount

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String
  amount      Int
  date        DateTime @db.Date
  description String   @default("")
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([date])
  @@map("expenses")
}

model Return {
  id           Int      @id @default(autoincrement())
  saleId       Int      @map("sale_id")
  createdById  Int      @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  refundAmount Int      @map("refund_amount")
  costRestored Int      @map("cost_restored") // HPP barang yang kembali ke stok
  reason       String   @default("")

  sale      Sale         @relation(fields: [saleId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])
  items     ReturnItem[]

  @@index([createdAt])
  @@index([saleId])
  @@map("returns")
}

model ReturnItem {
  id           Int @id @default(autoincrement())
  returnId     Int @map("return_id")
  saleItemId   Int @map("sale_item_id")
  qty          Int
  refundAmount Int @map("refund_amount")
  costRestored Int @map("cost_restored")

  return   Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
  @@index([saleItemId])
  @@map("return_items")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Tabel session untuk connect-pg-simple (dikelola oleh library, didefinisikan di sini agar migrasi konsisten).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
