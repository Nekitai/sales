# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.
# Di hosting (Railway/Render/VPS panel) isi variabel yang sama lewat menu Environment Variables;
# file .env tidak wajib ada di server.
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dashboard_profit

# Session: buat dengan  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production menolak nilai contoh ini.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
SESSION_MAX_AGE_HOURS=12

# Domain frontend (CORS + pengecekan Origin). Pisahkan dengan koma bila lebih dari satu.
# Development: http://localhost:5173
# Production : WAJIB diisi, https://domain-anda (tanpa garis miring di akhir, tanpa path)
CLIENT_ORIGIN=http://localhost:5173

# Production di belakang reverse proxy (default true saat NODE_ENV=production).
# Isi false hanya bila Node langsung menghadap internet tanpa proxy.
TRUST_PROXY=
# SameSite cookie: lax (default; frontend & API satu domain) atau none (beda domain; wajib HTTPS)
COOKIE_SAMESITE=lax
# Sajikan hasil build frontend dari server ini (default true saat production). Satu domain = login paling sederhana.
SERVE_CLIENT=

# Aturan bisnis
MAX_CASHIER_DISCOUNT_PERCENT=10
LOW_STOCK_THRESHOLD=6
# Offset zona waktu toko dalam menit (WITA = 480, WIB = 420, WIT = 540)
TZ_OFFSET_MINUTES=480

# Hanya dipakai oleh `npm run seed` untuk akun owner pertama
SEED_OWNER_USERNAME=owner
SEED_OWNER_NAME=Owner Andra Copotan
# Jangan pakai karakter # tanpa tanda kutip (dibaca sebagai komentar)
# Production: minimal 10 karakter. Kosongkan lagi setelah seed dijalankan.
SEED_OWNER_PASSWORD=
# Produk contoh bawaan aplikasi lama adalah sembako, bukan suku cadang. Biarkan false.
SEED_SAMPLE_PRODUCTS=false
