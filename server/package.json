{
  "name": "dashboard-profit-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "migrate:deploy": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "migrate:dev": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "seed": "node --env-file-if-exists=.env prisma/seed.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 test/api.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
